# Copy this file to .env (same folder) and fill it in. .env is never committed.

# Garmin Connect Personal API key, from Garmin Connect web > Settings > Personal API Key.
# Treat it like a password.
GARMIN_API_KEY=

# The key's expiry date as Garmin Connect shows it (YYYY-MM-DD). The app warns you 7 days before.
GARMIN_API_KEY_EXPIRES=

# Your time zone, and the local time of the daily sync.
TZ=Europe/Bucharest
GLA_SYNC_TIME=06:30

# Optional. false hides the API docs page at /docs (for example when hosted).
# GLA_API_DOCS=true
